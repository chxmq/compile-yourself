array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }


func main() {
    initpw();
    pl(2 + 3 * 4);          // 14
    pl((2 + 3) * 4);        // 20
    pl(10 - 3 - 2);         // 5  (left assoc)
    pl(2 * 3 + 4 * 5);      // 26
    pl(-2 * 3);             // -6
    pl(- -3);               // 3
    pl(2 - -3);             // 5
    pl(-2 * -3);            // 6
    pl(1 + 2 < 4);          // 1
    pl(1 < 2 == 1);         // (1<2)==1 -> 1
    pl(1 < 2 < 3);          // (1<2)<3 -> 1
    pl(3 > 2 > 1);          // (3>2)>1 -> 0
    pl(2 == 2 == 1);        // 1
    pl(5 - 3 < 4 - 1);      // 2<3 -> 1
    pl(4 - 1 - 1 - 1);      // 1
    pl(2 * 3 * 4);          // 24
    pl(1 + -1);             // 0
    pl(5 != 5);             // 0
    pl(5 != 4);             // 1
    pl(3 <= 3);             // 1
    pl(3 >= 4);             // 0
    pl(0 == 1 != 1);        // (0==1)!=1 -> 0!=1 -> 1
    pl(-3 < -2);            // 1
    pl(1 - 1 == 0);         // 1
    pl(2 + 3 * 4 - 5 * 6);  // -16
    pl(100 - 10 * 10 + 1);  // 1
    pl(-(2 + 3) * 2);       // -10
    pl(7 * (3 - 5) + 1);    // -13
    pl(1 + 1 == 2 * 1);     // 1
}
