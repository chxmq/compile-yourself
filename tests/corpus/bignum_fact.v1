
// 60! as decimal digits using base-10 digit array; division by 10 via repeated subtraction
array dig[100];
var nd;
func mulsmall(m) {
    var i; var carry; var v; var q;
    i = 0; carry = 0;
    while (i < nd) {
        v = dig[i] * m + carry;
        q = 0;
        while (v >= 10) { v = v - 10; q = q + 1; }
        dig[i] = v;
        carry = q;
        i = i + 1;
    }
    while (carry > 0) {
        q = 0;
        while (carry >= 10) { carry = carry - 10; q = q + 1; }
        dig[nd] = carry;
        nd = nd + 1;
        carry = q;
    }
    return 0;
}
func main() {
    var i;
    dig[0] = 1; nd = 1;
    i = 2;
    while (i <= 60) { mulsmall(i); i = i + 1; }
    i = nd - 1;
    while (i >= 0) { putc(48 + dig[i]); i = i - 1; }
    putc(10);
}
