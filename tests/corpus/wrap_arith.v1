array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }


func main() {
    initpw();
    pl(2147483647 + 1);                 // -2147483648
    pl(2147483647 + 2147483647);        // -2
    pl(-2147483647 - 2);                // 2147483647
    pl(65536 * 65536);                  // 0
    pl(46341 * 46341);                  // -2147479015
    pl(2147483647 * 2);                 // -2
    pl(2147483647 * 2147483647);        // 1
    pl(123456789 * 987654321);          // -67153019
    pl(1000000 * 1000000);              // -727379968
    pl(-2147483647 - 1 - 1);            // 2147483647
    pl(2147483647 * -1);                // -2147483647
    pl(100000 * 100000 * 100000);       // 1215752192 * 100000 wrapped
    pl(3 * 1431655766);                 // 4294967298 -> 2
    pl(-2147483647 * 2147483647);       // -1
    pl(2147483647 + 1 - 1);             // 2147483647 (wrap and back)
    pl(2147483647 + 1 + 1);             // -2147483647
}
