array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }


var g;
func a() { g = g + 1; }
func b(x) { if (x > 0) { return 5; } }
func c() { var i; i = 0; while (i < 3) { i = i + 1; } }
func d() { return 9; g = 100; }
func main() {
    initpw();
    pl(a());        // 0
    pl(g);          // 1
    pl(b(1));       // 5
    pl(b(0));       // 0
    pl(b(-1) + 3);  // 3
    pl(c());        // 0
    pl(d());        // 9
    pl(g);          // 1
}
