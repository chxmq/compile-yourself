array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }


func b(x) { pl(x); return 0; }
func main() {
    var big; var neg; var mx; var mn;
    initpw();
    b(2000000000 < -2000000000);   // 0
    b(-2000000000 < 2000000000);   // 1
    b(2000000000 > -2000000000);   // 1
    b(-2000000000 > 2000000000);   // 0
    b(2000000000 <= -2000000000);  // 0
    b(-2000000000 <= 2000000000);  // 1
    b(2000000000 >= -2000000000);  // 1
    b(-2000000000 >= 2000000000);  // 0
    big = 2000000000; neg = -2000000000;
    b(big < neg); b(neg < big); b(big > neg); b(neg > big);   // 0 1 1 0
    b(big <= neg); b(neg <= big); b(big >= neg); b(neg >= big); // 0 1 1 0
    mx = 2147483647; mn = -2147483647 - 1;
    b(mx < mn); b(mn < mx); b(mx > mn); b(mn > mx);   // 0 1 1 0
    b(mx < -1); b(mx > -1); b(-1 < mx); b(-1 > mx);   // 0 1 1 0
    b(mn < 1); b(mn > 1); b(1 < mn); b(1 > mn);       // 1 0 0 1
    b(mx == mn); b(mx != mn);                          // 0 1
    b(1500000000 < -1500000000); b(-1500000000 < 1500000000); // 0 1
    b(mx + 1 < mx);   // wrap: mx+1 = mn < mx -> 1
    b(mx + 1 > mx);   // 0
}
