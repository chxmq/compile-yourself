
func main() {
    putc(256 + 65);          // A
    putc(-1);                // 255
    putc(-256 + 66);         // B
    putc(65 + 1024);         // A
    putc(2147483647);        // 255
    putc(-2147483647 - 1);   // 0
    putc(-2147483647 - 1 + 67);  // C
    putc(65536 * 65536 + 68);    // D
    putc(2147483647 + 2 + 69 - 2147483647 + 2147483647); // low 8 bits = 70 = F
    putc(10 - 256 * 1000);   // newline
    putc(0);
    putc(255);
    putc(-255);              // 1
    putc(putc(70) + 71);     // F then G (putc returns 0)
    putc(10);
}
