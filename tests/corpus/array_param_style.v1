array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }


array m[16];
func set(i, j, v) { m[i * 4 + j] = v; return 0; }
func get(i, j) { return m[i * 4 + j]; }
func main() {
    var i; var j; var s;
    initpw();
    i = 0;
    while (i < 4) { j = 0; while (j < 4) { set(i, j, i * 10 + j); j = j + 1; } i = i + 1; }
    s = 0; i = 0;
    while (i < 4) { s = s + get(i, 3 - i); i = i + 1; }
    pl(s);          // 3 + 12 + 21 + 30 = 66
    pl(get(2, 1));  // 21
}
