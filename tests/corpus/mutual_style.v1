array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }


// even/odd without forward references: odd defined first, calls only itself
func parity(n) {
    var p;
    p = 0;
    while (n > 0) { n = n - 1; p = 1 - p; }
    return p;
}
func sumto(n) { if (n == 0) { return 0; } return n + sumto(n - 1); }
func power(b, e) { if (e == 0) { return 1; } return b * power(b, e - 1); }
func main() {
    initpw();
    pl(parity(7)); pl(parity(100)); pl(sumto(500)); pl(power(2, 31)); pl(power(2, 32)); pl(power(3, 20)); pl(power(-2, 31));
}
