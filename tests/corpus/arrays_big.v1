array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }


array big[100000];
array one[1];
func main() {
    var i; var s;
    initpw();
    i = 0;
    while (i < 100000) { big[i] = i; i = i + 1; }
    s = 0;
    i = 99999;
    while (i >= 0) { s = s + big[i] * (i - 50000); i = i - 1; }
    pl(s);
    one[0] = 5; one[0] = one[0] * one[0];
    pl(one[0]);       // 25
    pl(big[0] + big[99999]);  // 99999
}
