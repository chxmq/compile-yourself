array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }


var g;
array a[4];
func e() { }
func id(x) { return x; }
func main() {
    var x; var y;
    initpw();
    e();
    x = (((1)));
    y = ((x + 2)) * (id(3));
    pl(x); pl(y);                 // 1 9
    a[0] = 3; a[a[0]] = 2; a[a[a[0]]] = 1;   // a[3]=2, a[2]=1
    pl(a[3]); pl(a[2]);           // 2 1
    a[id(1)] = id(a[3]) + a[a[2]];   // a[1] = 2 + a[1]... evaluate: a[1] read before assign -> 2+0 = 2
    pl(a[1]);                     // 2
    if (x) { }
    if (0) { } else { }
    while (0) { }
    g = id(id(id(5)));
    pl(g);                        // 5
    g = g;
    x = x + 0 * g;
    pl(x);                        // 1
    if (x) { if (g) { if (y) { pl(100); } } }
    pl(id(-3) * id(-4));          // 12
}
