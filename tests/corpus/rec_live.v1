// self calls: which locals survive a call (loop-carried values, operands pending in the expression, dead locals)
array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}



func pl(n) { pnum(n); putc(10); return 0; }

func f(n, a, b) {
    var i; var s; var t;
    s = 0; t = a + b;
    i = 0;
    while (i < n) {
        s = s + f(n - 1 - i, t, i) + i;
        i = i + 1;
    }
    if (n == 0) { return a * 2 + b; }
    return s + t;
}
func g(n, m) {
    var dead1; var dead2; var keep;
    dead1 = n * 3; dead2 = m * 5; keep = n + m;
    if (n < 1) { return keep; }
    return g(n - 1, m + 1) + keep * 2 + g(n - 1, m);
}
func h(x, y) {
    var z;
    z = x + y;
    if (x <= 0) { return z; }
    return z * h(x - 1, y) - z;
}
func k(n) {
    var r; var q;
    r = n; q = 0;
    if (n > 0) {
        q = k(n - 1);
        r = r * 2 + q;
    }
    return r + n;
}
func main() {
    initpw();
    pl(f(4, 1, 2));
    pl(g(6, 1));
    pl(h(5, 3));
    pl(k(12));
}
