array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }


// reads lines "a op b" with single-digit-or-more numbers; prints result per line. op in + - *
var cur;      // lookahead char
func adv() { cur = getc(); return 0; }
func skipsp() { while (cur == 32) { adv(); } return 0; }
func readnum() {
    var v;
    v = 0;
    while (cur >= 48) {
        if (cur <= 57) { v = v * 10 + cur - 48; adv(); } else { return v; }
    }
    return v;
}
func main() {
    var a; var b; var op;
    initpw();
    adv();
    while (cur != -1) {
        skipsp();
        a = readnum();
        skipsp();
        op = cur; adv();
        skipsp();
        b = readnum();
        while (cur != 10) { if (cur == -1) { return 0; } adv(); }
        adv();
        if (op == 43) { pl(a + b); }
        if (op == 45) { pl(a - b); }
        if (op == 42) { pl(a * b); }
    }
}
