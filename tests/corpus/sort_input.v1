array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }


array buf[1000];
func main() {
    var n; var i; var j; var t; var c;
    initpw();
    n = 0;
    c = getc();
    while (c >= 0) { buf[n] = c; n = n + 1; c = getc(); }
    i = 0;
    while (i < n) {
        j = 0;
        while (j < n - 1 - i) {
            if (buf[j] > buf[j + 1]) { t = buf[j]; buf[j] = buf[j + 1]; buf[j + 1] = t; }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < n) { putc(buf[i]); i = i + 1; }
    putc(10);
}
