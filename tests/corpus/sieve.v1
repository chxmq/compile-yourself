array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }


array comp[2001];
func main() {
    var i; var j; var cnt; var last;
    initpw();
    cnt = 0; last = 0;
    i = 2;
    while (i <= 2000) {
        if (comp[i] == 0) {
            cnt = cnt + 1;
            last = i;
            j = i + i;
            while (j <= 2000) { comp[j] = 1; j = j + i; }
        }
        i = i + 1;
    }
    pl(cnt);    // 303
    pl(last);   // 1999
}
