array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }

// Toy-language evaluator written in v1: tokenizer + recursive-descent parser/evaluator.
// Input statements:  name = expr ;   |   print expr ;     (names up to 8 letters)
// Operators: unary -, * , + -, comparisons < > <= >= == !=, parentheses. '#' starts a comment.

array src[4000];       // raw input
var srclen;
var ti;                // tokenizer index
array tt[2000];        // token types: 0 end, 1 number, 2 ident (value = symbol index), 3 operator
array tv[2000];        // token values
var ntok;
var pos;               // parser position
array symname[600];    // 60 symbols * 10 chars
array symval[60];
var nsym;
var errors;
var printed;
array curname[10];
var curlen;

func isdigit(c) { if (c >= 48) { if (c <= 57) { return 1; } } return 0; }
func isalpha(c) {
    if (c >= 97) { if (c <= 122) { return 1; } }
    if (c >= 65) { if (c <= 90) { return 1; } }
    if (c == 95) { return 1; }
    return 0;
}
func isspace(c) {
    if (c == 32) { return 1; }
    if (c == 10) { return 1; }
    if (c == 9) { return 1; }
    if (c == 13) { return 1; }
    return 0;
}

func readall() {
    var c;
    srclen = 0;
    c = getc();
    while (c != -1) {
        if (srclen < 4000) { src[srclen] = c; srclen = srclen + 1; }
        c = getc();
    }
    return srclen;
}

// ---- symbol table: name stored as chars at symname[idx*10 .. +9], zero terminated
func symfind() {
    var i; var j; var same;
    i = 0;
    while (i < nsym) {
        same = 1;
        j = 0;
        while (j <= curlen) {
            if (symname[i * 10 + j] != curname[j]) { same = 0; }
            j = j + 1;
        }
        if (same) { return i; }
        i = i + 1;
    }
    return -1;
}
func symadd() {
    var j;
    if (nsym >= 60) { errors = errors + 1; return 0; }
    j = 0;
    while (j <= curlen) { symname[nsym * 10 + j] = curname[j]; j = j + 1; }
    symval[nsym] = 0;
    nsym = nsym + 1;
    return nsym - 1;
}
func symlookup() {
    var i;
    i = symfind();
    if (i < 0) { i = symadd(); }
    return i;
}

// ---- tokenizer
func addtok(t, v) {
    if (ntok < 2000) { tt[ntok] = t; tv[ntok] = v; ntok = ntok + 1; }
    return 0;
}
func peekc(k) {
    if (ti + k < srclen) { return src[ti + k]; }
    return 0;
}
func lexnumber() {
    var n;
    n = 0;
    while (isdigit(peekc(0))) { n = n * 10 + peekc(0) - 48; ti = ti + 1; }
    addtok(1, n);
    return 0;
}
func lexident() {
    var c;
    curlen = 0;
    c = peekc(0);
    while (isalpha(c) + isdigit(c)) {
        if (curlen < 8) { curname[curlen] = c; curlen = curlen + 1; }
        ti = ti + 1;
        c = peekc(0);
    }
    curname[curlen] = 0;
    addtok(2, symlookup());
    return 0;
}
func lexop() {
    var c; var d;
    c = peekc(0); d = peekc(1);
    ti = ti + 1;
    if (d == 61) {
        if (c == 61) { ti = ti + 1; addtok(3, 256); return 0; }   // ==
        if (c == 60) { ti = ti + 1; addtok(3, 257); return 0; }   // <=
        if (c == 62) { ti = ti + 1; addtok(3, 258); return 0; }   // >=
        if (c == 33) { ti = ti + 1; addtok(3, 259); return 0; }   // !=
    }
    addtok(3, c);
    return 0;
}
func tokenize() {
    var c;
    ti = 0; ntok = 0;
    while (ti < srclen) {
        c = src[ti];
        if (isspace(c)) {
            ti = ti + 1;
        } else {
            if (c == 35) {
                c = 1;
                while (c) {
                    if (ti >= srclen) { c = 0; } else { if (src[ti] == 10) { c = 0; } else { ti = ti + 1; } }
                }
            } else {
                if (isdigit(c)) { lexnumber(); }
                else {
                    if (isalpha(c)) { lexident(); } else { lexop(); }
                }
            }
        }
    }
    addtok(0, 0);
    return ntok;
}


// ---- parser / evaluator (single recursive function: no forward declarations in v1)
func isop(v) { if (tt[pos] == 3) { if (tv[pos] == v) { return 1; } } return 0; }

// level 0: comparisons, 1: + -, 2: *, 3: unary and primary
func parse(level) {
    var l; var r; var op; var go;
    if (level == 3) {
        if (isop(45)) { pos = pos + 1; return -parse(3); }
        if (tt[pos] == 1) { l = tv[pos]; pos = pos + 1; return l; }
        if (tt[pos] == 2) { l = symval[tv[pos]]; pos = pos + 1; return l; }
        if (isop(40)) {
            pos = pos + 1;
            l = parse(0);
            if (isop(41)) { pos = pos + 1; } else { errors = errors + 1; }
            return l;
        }
        errors = errors + 1;
        if (tt[pos] != 0) { pos = pos + 1; }
        return 0;
    }
    l = parse(level + 1);
    go = 1;
    while (go) {
        go = 0;
        if (tt[pos] == 3) {
            op = tv[pos];
            if (level == 2) {
                if (op == 42) { pos = pos + 1; r = parse(3); l = l * r; go = 1; }
            }
            if (level == 1) {
                if (op == 43) { pos = pos + 1; r = parse(2); l = l + r; go = 1; }
                else { if (op == 45) { pos = pos + 1; r = parse(2); l = l - r; go = 1; } }
            }
            if (level == 0) {
                if (op == 60) { pos = pos + 1; r = parse(1); l = l < r; go = 1; }
                if (op == 62) { pos = pos + 1; r = parse(1); l = l > r; go = 1; }
                if (op == 256) { pos = pos + 1; r = parse(1); l = l == r; go = 1; }
                if (op == 257) { pos = pos + 1; r = parse(1); l = l <= r; go = 1; }
                if (op == 258) { pos = pos + 1; r = parse(1); l = l >= r; go = 1; }
                if (op == 259) { pos = pos + 1; r = parse(1); l = l != r; go = 1; }
            }
        }
    }
    return l;
}

func skipstmt() {
    while (tt[pos] != 0) {
        if (isop(59)) { pos = pos + 1; return 0; }
        pos = pos + 1;
    }
    return 0;
}

func runstmt() {
    var v; var target;
    if (tt[pos] == 2) {
        if (tv[pos] == 0) {                       // print expr ;
            pos = pos + 1;
            v = parse(0);
            if (isop(59)) { pos = pos + 1; } else { errors = errors + 1; skipstmt(); }
            pnum(v); putc(10);
            printed = printed + 1;
            return 0;
        }
        if (tt[pos + 1] == 3) {
            if (tv[pos + 1] == 61) {              // name = expr ;
                target = tv[pos];
                pos = pos + 2;
                v = parse(0);
                if (isop(59)) { pos = pos + 1; } else { errors = errors + 1; skipstmt(); }
                symval[target] = v;
                return 0;
            }
        }
    }
    errors = errors + 1;
    skipstmt();
    return 0;
}

func interp() {
    pos = 0;
    while (tt[pos] != 0) { runstmt(); }
    return 0;
}

func initsyms() {
    curlen = 5;
    curname[0] = 112; curname[1] = 114; curname[2] = 105; curname[3] = 110; curname[4] = 116; curname[5] = 0;
    symadd();     // symbol 0 is "print"
    return 0;
}

// ---- generated helper functions (checksummed in main)
func h0(x, y) {
    var i; var s;
    s = x;
    i = 0;
    while (i < 7) { s = s * 85 + y + i; i = i + 1; }
    return s + 405;
}
func h1(x, y) {
    if (x < y) { return y * 15 - x + 841; }
    if (x == y) { return 10; }
    return x * 15 - y * 10;
}
func h2(x, y) {
    var t;
    t = h1(x, y + 47);
    return t * 27 + h0(y, x) - 597;
}
