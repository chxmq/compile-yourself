func main() {
    var chk; var k;
    initpw();
    readall();
    initsyms();
    tokenize();
    interp();
    pnum(errors); putc(10);
    pnum(ntok); putc(10);
    chk = 17;
    k = 0;
    chk = chk * 31 + h0(chk, 0);
    chk = chk * 31 + h1(chk, 1);
    chk = chk * 31 + h2(chk, 2);
    chk = chk * 31 + h3(chk, 3);
    chk = chk * 31 + h4(chk, 4);
