    chk = chk * 31 + h27(chk, 27);
    chk = chk * 31 + h28(chk, 28);
    chk = chk * 31 + h29(chk, 29);
    chk = chk * 31 + h30(chk, 30);
    chk = chk * 31 + h31(chk, 31);
    chk = chk * 31 + h32(chk, 32);
    chk = chk * 31 + h33(chk, 33);
    chk = chk * 31 + h34(chk, 34);
    chk = chk * 31 + h35(chk, 35);
    chk = chk * 31 + h36(chk, 36);
    chk = chk * 31 + h37(chk, 37);
    chk = chk * 31 + h38(chk, 38);
