array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }


array cnt[26];
func main() {
    var c; var i; var j;
    initpw();
    c = getc();
    while (c != -1) {
        if (c >= 97) { if (c <= 122) { cnt[c - 97] = cnt[c - 97] + 1; } }
        c = getc();
    }
    i = 0;
    while (i < 26) {
        if (cnt[i]) {
            putc(97 + i); putc(32);
            j = 0;
            while (j < cnt[i]) { putc(35); j = j + 1; }
            putc(32); pnum(cnt[i]); putc(10);
        }
        i = i + 1;
    }
}
