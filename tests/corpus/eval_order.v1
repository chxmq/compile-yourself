array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }


var cnt;
var g;
func tick() { cnt = cnt + 1; return cnt; }
func setg(v) { g = v; return v; }
func show3(a, b, c) { return a * 100 + b * 10 + c; }
func main() {
    initpw();
    cnt = 0;
    pl(show3(tick(), tick(), tick()));            // 123
    cnt = 0;
    pl(tick() * 100 + tick() * 10 + tick());      // 123
    cnt = 0;
    pl(tick() - tick());                          // 1 - 2 = -1
    cnt = 0;
    pl(tick() < tick());                          // 1
    cnt = 0;
    pl(tick() > tick());                          // 0
    g = 1;
    pl(g + setg(5));                              // left operand first: 1 + 5 = 6
    g = 1;
    pl(setg(5) + g);                              // 5 + 5 = 10
    g = 2;
    pl(g * setg(10) - g);                         // 2*10 - 10 = 10
    cnt = 0;
    pl(show3(tick() + tick(), tick() * tick(), tick()));  // (1+2) (3*4) 5 -> 300+120+5 = 425
    cnt = 0;
    pl(show3(show3(tick(), tick(), tick()) - 100, tick(), tick()));  // (123-100) 4 5 -> 2300+40+5=2345
}
