array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }


var g1; var g2;
array a[10];
array b[3];
func fill() {
    var i;
    i = 0;
    while (i < 10) { a[i] = i * i; i = i + 1; }
    return 0;
}
func sum() {
    var i; var s;
    i = 0; s = 0;
    while (i < 10) { s = s + a[i]; i = i + 1; }
    return s;
}
func main() {
    initpw();
    pl(g1); pl(g2);                 // 0 0
    pl(a[0] + a[9] + b[0] + b[2]);  // 0
    fill();
    pl(sum());                      // 285
    a[a[3]] = 77;                   // a[9] = 77
    pl(a[9]);                       // 77
    a[1 + 1] = a[2 + 1] + a[2 + 2]; // a[2] = 9 + 16 = 25
    pl(a[2]);                       // 25
    b[2] = -5; b[0] = b[2] * b[2];
    pl(b[0]); pl(b[1]); pl(b[2]);   // 25 0 -5
    g1 = a[4] * 2147483647;         // 16 * INT_MAX wraps
    pl(g1);                         // -16
    pl(sum());                      // 285 - 81 + 77 - 4 + 25 = 302
}
