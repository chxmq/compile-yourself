array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }


func max(a, b) { if (a > b) { return a; } return b; }
func min(a, b) { if (a < b) { return a; } return b; }
func abs(a) { if (a < 0) { return -a; } return a; }
func main() {
    initpw();
    pl(max(3, 9)); pl(min(3, 9)); pl(max(-3, -9)); pl(min(-3, -9));
    pl(abs(-5)); pl(abs(5)); pl(abs(0));
    pl(abs(-2147483647 - 1));              // -2147483648 (still negative)
    pl(max(-2147483647 - 1, 2147483647));  // 2147483647
    pl(min(2000000000, -2000000000));      // -2000000000
    pl(max(max(1, 2), max(3, min(4, 5))));  // 4
}
