array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }


func main() {
    var i; var j; var s;
    initpw();
    s = 0;
    i = 0;
    while (i < 3) {
        if (i >= 0) { if (i < 5) { if (i != 7) { if (i + 1) { if (1) { if (2) { if (3) { if (4) {
            j = 0;
            while (j < 3) {
                if (j == 1) { if (i == 1) { s = s + 100; } else { s = s + 10; } } else { s = s + 1; }
                j = j + 1;
            }
        } } } } } } } }
        i = i + 1;
    }
    pl(s);   // per i: j=0 ->1, j=1 -> 10 or 100, j=2 -> 1 : 12+102+12 = 126
}
