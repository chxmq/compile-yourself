array pw[10];
func initpw() {
    var i;
    pw[0] = 1;
    i = 1;
    while (i < 10) { pw[i] = pw[i - 1] * 10; i = i + 1; }
    return 0;
}
// prints n in decimal (handles INT_MIN: never negates)
func pnum(n) {
    var neg; var i; var d; var started;
    neg = 0;
    if (n < 0) { neg = 1; putc(45); }
    started = 0;
    i = 9;
    while (i >= 0) {
        d = 0;
        if (neg) {
            while (n <= 0 - pw[i]) { n = n + pw[i]; d = d + 1; }
        } else {
            while (n >= pw[i]) { n = n - pw[i]; d = d + 1; }
        }
        if (started + d + (i == 0)) { putc(48 + d); started = 1; }
        i = i - 1;
    }
    return 0;
}
func pl(n) { pnum(n); putc(10); return 0; }


func t(x) { if (x) { return 1; } else { return 0; } }
func main() {
    var n; var c;
    initpw();
    pl(t(0)); pl(t(1)); pl(t(-1)); pl(t(2147483647)); pl(t(-2147483647 - 1));  // 0 1 1 1 1
    pl(t(65536 * 65536));        // wraps to 0 -> 0
    pl(t(65536 * 32768));        // INT_MIN -> 1
    pl(t(2147483647 + 1 + 2147483647 + 1));  // 0
    if (65536 * 65536) { pl(1); } else { pl(0); }   // 0
    n = 5; c = 0;
    while (n) { n = n - 1; c = c + 1; }
    pl(c);                       // 5
    n = 3; c = 0;
    while (n * 1073741824 * 2) { c = c + 1; n = n - 1; if (c > 10) { n = 0; } }  // 3*2^31 wraps to INT_MIN (true); 2*2^31 wraps to 0 (false)
    pl(c);
}
