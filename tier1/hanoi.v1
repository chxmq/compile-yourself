// HANOI: read n (1..8) and a newline; print the moves of the standard recursive solution,
// one per line, as source peg then destination peg (A start, C target, B spare).
func hanoi(n, from, to, via) {
    if (n == 0) { return 0; }
    hanoi(n - 1, from, via, to);
    putc(from);
    putc(to);
    putc(10);
    hanoi(n - 1, via, to, from);
    return 0;
}

func main() {
    var c; var n; var go;
    n = 0;
    go = 1;
    while (go) {
        c = getc();
        if (c < 48) { go = 0; } else {
            if (c > 57) { go = 0; } else { n = n * 10 + c - 48; }
        }
    }
    hanoi(n, 65, 67, 66);
}
