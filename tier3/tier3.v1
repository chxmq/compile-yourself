// tier3.v1 -- a v1 compiler written in v1.  Port of tier2/v1c.py (see tier3/NOTES.md).
// Reads a v1 program on stdin, prints the machine program (one decimal word per line).
// Output must be byte-identical to tier2/v1c.py.
//
// Structure: lex everything into the packed token array tv[]; then run the code generator
// twice over the tokens.  Pass 1 only counts code words and records label addresses and the
// literal pool; pass 2 emits.  Invalid input makes fail() raise a VM error (nonzero exit).

// ------------------------------------------------------------------ state
var narr;
array tv[60002];        // packed tokens: number v -> -1-v ; else kind*65536+value (2 name node, 3 keyword, 4 op); 0 = EOF
var ntk;
var tp;                 // index of current token
var ck;                 // kind of current token (0 eof, 1 num, 2 name, 3 kw, 4 op)
var cv;                 // value of current token

// The three trie arrays are only needed while lexing; afterwards they are reused (they are the biggest dead memory):
//   tch[i]    = cz[i]: 1 when a call "name (" occurs in tokens i .. next ; { }   (set at the end of lex)
//   tsib[k]   = base address of the k-th global array,  tchild[k] = its size
array tch[60200];       // trie: character of node
array tsib[60200];      // next sibling
array tchild[60200];   // first child
var nnodes;
// binding of each name node: 0 none; 1..2^21-1 global scalar cell; 2^21+base array;
// 2^22+index function; 2^23+0/1 getc/putc; 2^24+code keyword; 2^25+cell local
array gb[60200];
var getcnode;
var putcnode;
var mainnode;

var ZERO;
var ONE;
var NEG1;
var T;
var U;
var T1;
var RV;
var dp;                 // next free data cell
var pcc;                // code words emitted so far
var pass;
var cend;               // 6 + code length (known after pass 1)
var npool;
var nlab;
var mul_used;
var MA;
var MB;
var MR;
var MNA;
var MRA;
var LMUL;
var LBOOT;
var depth;
var pend;               // operators whose right operand is being parsed
var want;               // destination cell for the value of the expression being parsed (0 none)
var wantp;              // pend value at which want applies
var stmtcall;           // the call being parsed is a whole statement
var fend;               // token index of the closing brace of the current function
var loop0;              // token index of the outermost enclosing while (-1: none)
var stmt0;              // token index where the current statement starts
var fbase;              // dp at the start of the current function (cell offsets index lmark)
var stamp;              // call-site counter: lmark[x] == stamp marks a local referenced later
var nt;                 // number of temps created in this function
var nfuncs;
var curfn;
var f_ra;
var nloc;
var ng;
var asp;
var ch;
var nread;

array lab[60100];
array poolv[60100];
array tcells[4100];
array gvc[10100];       // cells of global scalars, strictly decreasing
array locnode[10100];
array locsave[10100];
array fent[200];
array fnp[200];
array fra[200];
array fpc[1600];
array argstk[4100];
array mpl[32];
array mnl[32];
array lent[32];
array lsmx[32];
array lmark[14400];
array sv[14400];         // cells saved by the self call being compiled
array p10[10];
array p2[32];
array pnn[16];
array junk[1];

func fail() {
    junk[0 - 2000000] = 1;
    return 0;
}

// ------------------------------------------------------------------ lexer
func rd() {
    ch = getc();
    if (ch != -1) {
        nread = nread + 1;
        if (nread > 60000) { fail(); }
    }
    return 0;
}

func isdig(c) {
    if (c < 48) { return 0; }
    if (c > 57) { return 0; }
    return 1;
}

func isalp(c) {
    if (c >= 97) { if (c <= 122) { return 1; } }
    if (c >= 65) { if (c <= 90) { return 1; } }
    if (c == 95) { return 1; }
    return 0;
}

func trie_step(par, c) {
    var n;
    n = tchild[par];
    while (n != 0) {
        if (tch[n] == c) { return n; }
        n = tsib[n];
    }
    n = nnodes;
    nnodes = nnodes + 1;
    tch[n] = c;
    tsib[n] = tchild[par];
    tchild[par] = n;
    return n;
}

var kcur;
func kwc(c) {
    kcur = trie_step(kcur, c);
    return 0;
}
// finish a pre-inserted name: bind it to value b, return its node
func kwend(b) {
    var n;
    n = kcur;
    gb[n] = b;
    kcur = 0;
    return n;
}

func tokpush(x) {
    tv[ntk] = x;
    ntk = ntk + 1;
    return 0;
}

func issingle(c) {
    if (c == 43) { return 1; }
    if (c == 45) { return 1; }
    if (c == 42) { return 1; }
    if (c == 40) { return 1; }
    if (c == 41) { return 1; }
    if (c == 123) { return 1; }
    if (c == 125) { return 1; }
    if (c == 91) { return 1; }
    if (c == 93) { return 1; }
    if (c == 59) { return 1; }
    if (c == 44) { return 1; }
    return 0;
}

func known(c) {
    if (c == 10) { return 1; }
    if (c == 32) { return 1; }
    if (c == 9) { return 1; }
    if (c == 13) { return 1; }
    if (c == 47) { return 1; }
    if (c == 60) { return 1; }
    if (c == 62) { return 1; }
    if (c == 61) { return 1; }
    if (c == 33) { return 1; }
    if (isdig(c)) { return 1; }
    if (isalp(c)) { return 1; }
    return issingle(c);
}

func lex() {
    var c; var v; var d; var len; var node; var x;
    ntk = 0;
    nread = 0;
    rd();
    while (ch != -1) {
        c = ch;
        if (known(c) == 0) { fail(); }
        if (c == 10) { rd(); }
        if (c == 32) { rd(); }
        if (c == 9) { rd(); }
        if (c == 13) { rd(); }
        if (c == 47) {
            rd();
            if (ch != 47) { fail(); }
            while (ch != 10) {
                if (ch == -1) { ch = 10; } else { rd(); }
            }
        }
        if (isdig(c)) {
            v = 0;
            while (isdig(ch)) {
                d = ch - 48;
                if (v > 214748364) { fail(); }
                if (v == 214748364) { if (d > 7) { fail(); } }
                v = v * 10 + d;
                rd();
            }
            if (isalp(ch)) { fail(); }
            tokpush(0 - 1 - v);
        }
        if (isalp(c)) {
            node = 0;
            len = 0;
            while (isalp(ch) + isdig(ch)) {
                node = trie_step(node, ch);
                len = len + 1;
                rd();
            }
            if (len > 24) { fail(); }
            x = gb[node];
            if (x >= 16777216) {
                if (x < 33554432) {
                    tokpush(196608 + x - 16777216);
                    x = 0;
                    node = 0;
                }
            }
            if (node != 0) { tokpush(131072 + node); }
        }
        if (c == 60) { x = 300; }
        if (c == 62) { x = 301; }
        if (c == 61) { x = 302; }
        if (c == 33) { x = 303; }
        if (c == 60) { rd(); if (ch == 61) { rd(); tokpush(262144 + x); } else { tokpush(262144 + c); } }
        if (c == 62) { rd(); if (ch == 61) { rd(); tokpush(262144 + x); } else { tokpush(262144 + c); } }
        if (c == 61) { rd(); if (ch == 61) { rd(); tokpush(262144 + x); } else { tokpush(262144 + c); } }
        if (c == 33) { rd(); if (ch != 61) { fail(); } rd(); tokpush(262144 + x); }
        if (issingle(c)) { tokpush(262144 + c); rd(); }
    }
    tokpush(0);
    c = 0;
    v = ntk - 1;
    while (v >= 0) {
        x = tv[v];
        if (x == 262203) { c = 0; }
        if (x == 262267) { c = 0; }
        if (x == 262269) { c = 0; }
        if (x == 262184) {
            if (v > 0) {
                x = tv[v - 1];
                if (x >= 131072) { if (x < 196608) { c = 1; } }
            }
        }
        tch[v] = c;
        v = v - 1;
    }
    return 0;
}

// ------------------------------------------------------------------ token cursor
func setcur() {
    var x;
    x = tv[tp];
    if (x < 0) { ck = 1; cv = 0 - 1 - x; return 0; }
    ck = 4;
    if (x >= 262144) { cv = x - 262144; return 0; }
    ck = 3;
    if (x >= 196608) { cv = x - 196608; return 0; }
    ck = 2;
    if (x >= 131072) { cv = x - 131072; return 0; }
    ck = 0;
    cv = 0;
    return 0;
}

func adv() {
    tp = tp + 1;
    setcur();
    return 0;
}

func isop(c) {
    if (ck != 4) { return 0; }
    return cv == c;
}

func iskw(c) {
    if (ck != 3) { return 0; }
    return cv == c;
}

func eatop(c) {
    if (isop(c) == 0) { fail(); }
    adv();
    return 0;
}

func eatname() {
    var v;
    if (ck != 2) { fail(); }
    v = cv;
    adv();
    return v;
}

// ------------------------------------------------------------------ output
func outraw(v) {
    var i; var d; var go;
    if (v < 0) { putc(45); v = 0 - v; }
    i = 9;
    go = 1;
    while (go) {
        if (i == 0) { go = 0; } else {
            if (p10[i] > v) { i = i - 1; } else { go = 0; }
        }
    }
    while (i >= 0) {
        d = 0;
        while (v >= p10[i]) { v = v - p10[i]; d = d + 1; }
        putc(48 + d);
        i = i - 1;
    }
    putc(10);
    return 0;
}

func outw(v) {
    if (v >= 1073741824) {
        v = lab[v - 1073741824];
    } else {
        if (v >= 536870912) { v = cend + v - 536870912; }
    }
    outraw(v);
    return 0;
}

// ------------------------------------------------------------------ code buffer, cells, labels
func pc() { return 6 + pcc; }

func emit3(a, b, c) {
    if (pass == 2) { outw(a); outw(b); outw(c); }
    pcc = pcc + 3;
    return 0;
}

func emit2(a, b) {
    emit3(a, b, 6 + pcc + 3);
    return 0;
}

func newcell() {
    var c;
    c = dp;
    dp = dp - 1;
    return c;
}

func lit(v) {
    if (v == 0) { return 3; }
    if (v == 1) { return 4; }
    if (v == -1) { return 5; }
    poolv[npool] = v;
    npool = npool + 1;
    return 536870912 + npool - 1;
}

func newlabel() {
    if (pass == 1) { lab[nlab] = -1; }
    nlab = nlab + 1;
    return 1073741824 + nlab - 1;
}

func place(l) {
    lab[l - 1073741824] = 6 + pcc;
    return 0;
}

func tmp(i) {
    var c;
    while (nt <= i) {
        c = newcell();
        tcells[nt] = c;
        nt = nt + 1;
    }
    return tcells[i];
}

// ------------------------------------------------------------------ instruction sequences
func jmp(l) {
    emit3(NEG1, ZERO, l);
    return 0;
}

func clr(x) {
    emit2(x, x);
    return 0;
}

func mov(x, y) {
    if (x == y) { return 0; }
    emit2(x, x);
    emit2(T, T);
    emit2(T, y);
    emit2(x, T);
    return 0;
}

func isconst(c) {
    if (c >= 536870912) { return 1; }
    if (c == 3) { return 1; }
    if (c == 4) { return 1; }
    if (c == 5) { return 1; }
    return 0;
}

func constval(c) {
    if (c == 3) { return 0; }
    if (c == 4) { return 1; }
    if (c == 5) { return -1; }
    return poolv[c - 536870912];
}

// x = e; a literal is loaded as 0 - (-c)
func setto(x, e) {
    var c;
    if (isconst(e) == 0) { mov(x, e); return 0; }
    c = constval(e);
    clr(x);
    if (c != 0) { emit2(x, lit(0 - c)); }
    return 0;
}

func jnz(d, l) {
    emit3(d, ZERO, l);
    emit2(T, T);
    emit3(T, d, l);
    return 0;
}

func jz(d, l) {
    var p;
    p = pc();
    emit3(d, ZERO, p + 12);
    emit2(T, T);
    emit3(T, d, p + 12);
    jmp(l);
    return 0;
}

func diff(t, x, y) {
    emit2(t, t);
    emit2(T, T);
    emit2(T, x);
    emit2(t, T);
    emit2(t, y);
    return 0;
}

// expression temp: dead after the comparison that consumes it, so it may be overwritten
func istemp(c) {
    var i;
    i = 0;
    while (i < nt) {
        if (tcells[i] == c) { return 1; }
        i = i + 1;
    }
    return 0;
}

func lt_jf(x, y, lf) {
    var p; var nd; var a2; var d;
    p = pc();
    nd = 5;
    if (istemp(x)) { nd = 1; }
    a2 = p + 12 + 3 * nd;
    emit3(x, ZERO, a2);
    emit3(y, ZERO, lf);
    if (nd == 1) {
        emit2(x, y);
        d = x;
    } else {
        diff(T1, x, y);
        d = T1;
    }
    emit3(d, ZERO, a2 + 3);
    jmp(lf);
    emit3(y, ZERO, p + 6);
    return 0;
}

func lt_jt(x, y, lt) {
    var p; var nd; var a2; var d;
    p = pc();
    nd = 5;
    if (istemp(x)) { nd = 1; }
    a2 = p + 12 + 3 * nd;
    emit3(x, ZERO, a2);
    emit3(y, ZERO, a2 + 6);
    if (nd == 1) {
        emit2(x, y);
        d = x;
    } else {
        diff(T1, x, y);
        d = T1;
    }
    emit3(d, ZERO, lt);
    jmp(a2 + 6);
    emit3(y, ZERO, p + 6);
    jmp(lt);
    return 0;
}

func set_ra(ra, retaddr) {
    emit2(ra, ra);
    emit2(ra, lit(0 - retaddr));
    return 0;
}

// fill sv[] with the cells a self call must save: RA, the params/locals whose name occurs from the start of the
// current statement (or of the outermost enclosing loop) to the end of the function, then temps 0..d0-1.
// Returns their number.
func build_saved(d0) {
    var s0; var i; var x; var k; var m; var c;
    s0 = stmt0;
    if (loop0 >= 0) { s0 = loop0; }
    sv[0] = f_ra;
    m = 1;
    if (fend - s0 > 4000) {
        k = 0;
        while (k < nloc) {
            sv[m] = gb[locnode[k]] - 33554432;
            m = m + 1;
            k = k + 1;
        }
    } else {
        stamp = stamp + 1;
        i = s0;
        while (i < fend) {
            x = tv[i];
            if (x >= 131072) {
                if (x < 196608) {
                    x = gb[x - 131072];
                    if (x >= 33554432) { lmark[fbase - x + 33554432] = stamp; }
                }
            }
            i = i + 1;
        }
        k = 0;
        while (k < nloc) {
            c = gb[locnode[k]] - 33554432;
            if (lmark[fbase - c] == stamp) {
                sv[m] = c;
                m = m + 1;
            }
            k = k + 1;
        }
    }
    k = 0;
    while (k < d0) {
        sv[m] = tcells[k];
        m = m + 1;
        k = k + 1;
    }
    return m;
}

func push_cells(m) {
    var k; var b; var ck2;
    emit2(T, T);
    emit2(T, 536870912);
    k = 0;
    while (k < m) {
        ck2 = sv[k];
        b = pc();
        emit2(b + 18, b + 18);
        emit2(b + 18, T);
        emit2(b + 19, b + 19);
        emit2(b + 19, T);
        emit2(b + 21, b + 21);
        emit2(b + 21, T);
        emit2(0, 0);
        emit2(0, ck2);
        emit2(T, NEG1);
        k = k + 1;
    }
    emit2(536870912, lit(m));
    return 0;
}

func pop_cells(m) {
    var k; var b; var ck2;
    emit2(536870912, lit(0 - m));
    emit2(T, T);
    emit2(T, 536870912);
    k = 0;
    while (k < m) {
        ck2 = sv[k];
        b = pc();
        emit2(b + 10, b + 10);
        emit2(b + 10, T);
        emit2(ck2, ck2);
        emit2(ck2, 0);
        emit2(T, NEG1);
        k = k + 1;
    }
    return 0;
}

// ------------------------------------------------------------------ expressions: helpers
func is_stable(c) {
    var i;
    if (c < 6) { return 1; }
    if (c >= 536870912) { return 1; }
    i = 0;
    while (i < nt) {
        if (tcells[i] == c) { return 1; }
        i = i + 1;
    }
    return 0;
}

// is c the cell of a global scalar?  (gvc is strictly decreasing: binary search)
func isgvar(c) {
    var pos; var k; var s;
    pos = 0 - 1;
    k = 14;
    while (k >= 0) {
        s = pos + p2[k];
        if (s < ng) {
            if (gvc[s] > c) { pos = s; }
        }
        k = k - 1;
    }
    pos = pos + 1;
    if (pos < ng) {
        if (gvc[pos] == c) { return 1; }
    }
    return 0;
}

func snapshot_global(c, d0) {
    var t;
    if (isgvar(c)) {
        if (tch[tp]) {
            t = tmp(d0);
            mov(t, c);
            return t;
        }
    }
    return c;
}

// is the operation just parsed the last one of an expression whose value goes to want?
func isfinal() {
    if (want == 0) { return 0; }
    if (pend != wantp) { return 0; }
    if (ck != 4) { return 0; }
    if (cv == 59) { return 1; }
    if (cv == 44) { return 1; }
    if (cv == 41) { return 1; }
    return 0;
}

// cell for the result of an operation on l and r (op: token value, 0 for none)
func result_cell(d0, l, r, op) {
    var t;
    t = tmp(d0);
    if (isfinal()) {
        if (op == 45) { if (r == want) { if (l != want) { return t; } } }
        return want;
    }
    return t;
}

func lookup_scalar(n) {
    var x;
    x = gb[n];
    if (x >= 33554432) { return x - 33554432; }
    if (x > 0) { if (x < 2097152) { return x; } }
    fail();
    return 0;
}

func lookup_array(n) {
    var x;
    x = gb[n];
    if (x >= 2097152) { if (x < 4194304) { return x - 2097152; } }   // the array's ordinal
    fail();
    return 0;
}

func mul_const(res, x, c) {
    var neg; var m; var nb; var k; var rem; var bit; var kc; var top;
    if (c == 0) { clr(res); return 0; }
    neg = 0;
    m = c;
    if (c < 0) { neg = 1; m = 0 - c; }
    nb = 0;
    k = 0;
    while (k < 31) {
        if (p2[k] <= m) { nb = k + 1; }
        k = k + 1;
    }
    if (res != x) {
        if (nb == 1) {
            if (neg) { clr(res); emit2(res, x); } else { mov(res, x); }
            return 0;
        }
        if (neg) {
            kc = x;
        } else {
            emit2(U, U);
            emit2(U, x);
            kc = U;
        }
        clr(res);
        rem = m - p2[nb - 1];
        top = 2;
        if (rem >= p2[nb - 2]) { top = 3; rem = rem - p2[nb - 2]; }
        k = 0;
        while (k < top) { emit2(res, kc); k = k + 1; }
        bit = nb - 3;
        while (bit >= 0) {
            emit2(T, T);
            emit2(T, res);
            emit2(res, T);
            if (rem >= p2[bit]) {
                rem = rem - p2[bit];
                emit2(res, kc);
            }
            bit = bit - 1;
        }
        return 0;
    }
    if (m != p2[nb - 1]) { emit2(U, U); emit2(U, x); }
    rem = m - p2[nb - 1];
    bit = nb - 2;
    while (bit >= 0) {
        emit2(T, T);
        emit2(T, res);
        emit2(res, T);
        if (rem >= p2[bit]) {
            rem = rem - p2[bit];
            emit2(res, U);
        }
        bit = bit - 1;
    }
    if (neg) {
        emit2(T, T);
        emit2(U, U);
        emit2(T, res);
        emit2(U, T);
        emit2(res, res);
        emit2(res, U);
    }
    return 0;
}

func gen_mul(res, l, r) {
    if (isconst(r)) { mul_const(res, l, constval(r)); return 0; }
    if (isconst(l)) { mul_const(res, r, constval(l)); return 0; }
    if (mul_used == 0) {
        mul_used = 1;
        MA = newcell(); MB = newcell(); MR = newcell(); MNA = newcell();
        LMUL = newlabel();
    }
    mov(MA, l);
    mov(MB, r);
    set_ra(MRA, pc() + 9);
    jmp(LMUL);
    mov(res, MR);
    return 0;
}

// magnitude dispatch levels of the multiply routine: 3 6 10 14 18 22 26 30
func mlev(i) {
    if (i == 0) { return 3; }
    return 2 + 4 * i;
}

func emit_mul_routine() {
    var i; var e; var j; var p; var b; var lneg; var ldisp; var lmin; var lret; var ld30;
    j = 0;
    while (j < 31) { mpl[j] = lit(p2[j]); j = j + 1; }
    j = 0;
    while (j < 31) { mnl[j] = lit(0 - p2[j]); j = j + 1; }
    lneg = newlabel(); ldisp = newlabel(); lmin = newlabel(); ld30 = newlabel();
    lret = 6;
    j = 0;
    while (j < 31) { lent[j] = newlabel(); j = j + 1; }
    i = 0;
    while (i < 8) { lsmx[mlev(i)] = newlabel(); i = i + 1; }
    place(LMUL);
    clr(MR);
    emit3(MB, ZERO, lneg);
    emit2(MNA, MNA);
    emit2(MNA, MA);
    place(ldisp);
    i = 0;
    while (i < 8) {
        e = mlev(i);
        emit3(MB, mpl[e], lsmx[e]);
        emit2(MB, mnl[e]);
        i = i + 1;
    }
    jmp(lent[30]);
    i = 7;
    while (i >= 0) {
        e = mlev(i);
        place(lsmx[e]);
        emit2(MB, mnl[e]);
        if (e == 3) {
            p = pc();
            emit3(MB, ONE, lret);
            emit2(MR, MNA);
            jmp(p);
        } else {
            jmp(lent[e - 1]);
        }
        i = i - 1;
    }
    place(lneg);
    emit2(U, U);
    emit2(U, MB);
    mov(MB, U);
    mov(MNA, MA);
    emit3(MB, ZERO, lmin);
    jmp(ldisp);
    place(lmin);
    emit2(MB, mnl[30]);
    emit2(MB, mnl[30]);
    emit2(MR, MNA);
    jmp(ld30);
    j = 30;
    while (j >= 0) {
        if (j == 30) { place(ld30); }
        b = pc();
        emit2(T, T);
        emit2(T, MR);
        emit2(MR, T);
        place(lent[j]);
        emit3(MB, mpl[j], b + 18);
        emit2(MR, MNA);
        jmp(b + 21);
        emit2(MB, mnl[j]);
        j = j - 1;
    }
    jmp(lret);
    return 0;
}

func add_sub(res, l, r, op) {
    var t; var cl; var cr; var hl; var hr;
    hl = isconst(l);
    hr = isconst(r);
    cl = 0;
    cr = 0;
    if (hl) { cl = constval(l); }
    if (hr) { cr = constval(r); }
    if (op == 43) {
        if (r == res) {
            if (l != res) {
                t = l; l = r; r = t;
                t = hl; hl = hr; hr = t;
                t = cl; cl = cr; cr = t;
            }
        }
        if (l == res) {
            if (hr) {
                emit2(res, lit(0 - cr));
            } else {
                emit2(T, T); emit2(T, r); emit2(res, T);
            }
        } else {
            emit2(T, T); emit2(T, l); emit2(T, r);
            emit2(res, res); emit2(res, T);
        }
        return 0;
    }
    if (l == res) {
        emit2(res, r);
        return 0;
    }
    if (hl) {
        if (hr == 0) {
            emit2(res, res); emit2(res, r);
            if (cl != 0) { emit2(res, lit(0 - cl)); }
            return 0;
        }
    }
    emit2(res, res); emit2(T, T); emit2(T, l); emit2(res, T); emit2(res, r);
    return 0;
}

// operator precedence of the current token: 3 '*', 2 '+' '-', 1 comparisons, 0 none
func prec() {
    var v;
    if (ck != 4) { return 0; }
    v = cv;
    if (v == 42) { return 3; }
    if (v == 43) { return 2; }
    if (v == 45) { return 2; }
    if (v == 60) { return 1; }
    if (v == 62) { return 1; }
    if (v >= 300) { if (v <= 303) { return 1; } }
    return 0;
}

func cmp_jf(op, l, r, lf) {
    var p; var d; var t; var cr; var k; var nk;
    if (op >= 302) {
        if (isconst(l)) {
            if (isconst(r) == 0) { t = l; l = r; r = t; }
        }
        if (r == ZERO) {
            d = l;
        } else {
            if (isconst(l) == 0) {
                if (isconst(r)) {
                    nk = lit(0 - constval(r));
                    p = pc();
                    emit2(l, r);
                    emit3(l, ZERO, p + 18);
                    emit2(T, T); emit3(T, l, p + 18);
                    if (op == 302) {
                        emit2(l, nk); jmp(p + 24);
                        emit2(l, nk); jmp(lf);
                    } else {
                        emit2(l, nk); jmp(lf);
                        emit2(l, nk);
                    }
                    return 0;
                }
            }
            if (istemp(r)) {
                if (istemp(l) == 0) { t = l; l = r; r = t; }
            }
            if (istemp(l)) {
                emit2(l, r);
                d = l;
            } else {
                diff(T1, l, r);
                d = T1;
            }
        }
        if (op == 302) { jnz(d, lf); } else { jz(d, lf); }
        return 0;
    }
    if (r == ZERO) {
        if (op == 60) {
            p = pc();
            emit3(l, ZERO, p + 6);
            jmp(lf);
        }
        if (op == 301) {
            emit3(l, ZERO, lf);
        }
        if (op == 62) {
            p = pc();
            emit3(l, ZERO, lf);
            emit2(T, T);
            emit3(T, l, p + 12);
            jmp(lf);
        }
        if (op == 300) {
            p = pc();
            emit3(l, ZERO, p + 9);
            emit2(T, T);
            emit3(T, l, lf);
        }
        return 0;
    }
    if (isconst(r)) {
        cr = constval(r);
        if (cr > 0) {
            if (cr < 2147483647) {
                if (isconst(l) == 0) {
                    k = r;
                    if (op == 300) { cr = cr + 1; k = lit(cr); op = 60; }
                    else { if (op == 62) { cr = cr + 1; k = lit(cr); op = 301; } }
                    nk = lit(0 - cr);
                    p = pc();
                    if (op == 60) {
                        emit3(l, ZERO, p + 15);
                        emit3(l, k, p + 12);
                        emit2(l, nk); jmp(lf);
                        emit2(l, nk);
                    } else {
                        emit3(l, ZERO, lf);
                        emit3(l, k, p + 12);
                        emit2(l, nk); jmp(p + 18);
                        emit2(l, nk); jmp(lf);
                    }
                    return 0;
                }
            }
        }
    }
    if (op == 60) { lt_jf(l, r, lf); }
    if (op == 301) { lt_jt(l, r, lf); }
    if (op == 62) { lt_jf(r, l, lf); }
    if (op == 300) { lt_jt(r, l, lf); }
    return 0;
}

func cmp_value(op, l, r, res) {
    var lf; var le;
    lf = newlabel();
    le = newlabel();
    cmp_jf(op, l, r, lf);
    clr(res);
    emit2(res, NEG1);
    jmp(le);
    place(lf);
    clr(res);
    place(le);
    return 0;
}

func gen_getc(d0) {
    var res;
    depth = d0 + 1;
    res = result_cell(d0, 0, 0, 0);
    emit2(T, T);
    emit2(T, 1048574);
    emit2(res, res);
    emit2(res, T);
    return res;
}

func gen_putc(v) {
    emit2(T, T);
    emit2(T, v);
    emit2(1048575, T);
    return 0;
}

// unary minus of a non-literal operand e; d0 is the depth before e was parsed
func neg_result(e, d0) {
    var res;
    if (depth == d0) {
        depth = d0 + 1;
        res = tmp(d0);
        emit2(res, res);
        emit2(res, e);
        return res;
    }
    emit2(T, T);
    emit2(U, U);
    emit2(T, e);
    emit2(U, T);
    emit2(e, e);
    emit2(e, U);
    return e;
}

func gen_aread(i, base, size, d0) {
    var res; var wp; var ci;
    depth = d0 + 1;
    res = result_cell(d0, 0, 0, 0);
    if (isconst(i)) {
        ci = constval(i);
        if (ci >= 0) {
            if (ci < size) {
                emit2(res, res);
                emit2(res, base + ci);
                return res;
            }
        }
    }
    wp = pc() + 19;
    emit2(T, T);
    emit2(T, i);
    emit2(wp, wp);
    emit2(wp, T);
    emit2(wp, lit(0 - base));
    emit2(res, res);
    emit2(res, 0);
    return res;
}

// copy an argument operand to a temp when a later parameter copy or call could change it
func fix_arg(a, selfcall, j, fi) {
    var t; var k; var need;
    need = 0;
    if (selfcall) {
        k = 0;
        while (k < j) {
            if (fpc[fi * 8 + k] == a) { need = 1; }
            k = k + 1;
        }
    }
    if (isgvar(a)) {
        if (tch[tp]) { need = 1; }
    }
    if (need) {
        t = tmp(depth);
        depth = depth + 1;
        mov(t, a);
        return t;
    }
    return a;
}

// emit the call of function fi whose na argument operands are in argstk[base..]
func call_finish(fi, d0, base, na, selfcall, disc) {
    var m; var i; var res;
    m = 0;
    if (selfcall) {
        m = build_saved(d0);
        push_cells(m);
    }
    i = 0;
    while (i < na) {
        setto(fpc[fi * 8 + i], argstk[base + i]);
        i = i + 1;
    }
    set_ra(fra[fi], pc() + 9);
    jmp(fent[fi]);
    if (selfcall) { pop_cells(m); }
    asp = base;
    if (disc) {
        depth = d0;
        return ZERO;
    }
    depth = d0 + 1;
    res = result_cell(d0, 0, 0, 0);
    mov(res, RV);
    return res;
}

// expression parser by precedence climbing: parse(p) parses operators of precedence >= p
// (1 comparisons, 2 + -, 3 *); parse(4) is a unary operand.
func parse(p) {
    var d0; var l; var r; var res; var op; var pr; var v; var fi; var base; var na; var more; var sc;
    var disc; var sw; var swp;
    d0 = depth;
    v = cv;
    l = 0;
    if (ck == 1) {
        adv();
        l = lit(v);
    } else {
        if (isop(40)) {
            adv();
            pend = pend + 1;
            l = parse(1);
            pend = pend - 1;
            eatop(41);
        } else {
            if (isop(45)) {
                adv();
                if (ck == 1) {
                    l = lit(0 - cv);
                    adv();
                } else {
                    pend = pend + 1;
                    r = parse(4);
                    pend = pend - 1;
                    l = neg_result(r, d0);
                }
            } else {
                if (ck != 2) { fail(); }
                adv();
                if (isop(40)) {
                    disc = stmtcall;
                    stmtcall = 0;
                    if (v == getcnode) {
                        adv();
                        eatop(41);
                        l = gen_getc(d0);
                    } else {
                        if (v == putcnode) {
                            adv();
                            pend = pend + 1;
                            l = parse(1);
                            pend = pend - 1;
                            eatop(41);
                            gen_putc(l);
                            depth = d0;
                            l = ZERO;
                        } else {
                            fi = gb[v] - 4194304;
                            if (fi < 0) { fail(); }
                            if (fi >= 200) { fail(); }
                            sc = 0;
                            if (fi == curfn) { sc = 1; }
                            adv();
                            na = 0;
                            base = asp;
                            sw = want;
                            swp = wantp;
                            if (isop(41) == 0) {
                                more = 1;
                                while (more) {
                                    pend = pend + 1;
                                    want = 0;
                                    if (sc == 0) {
                                        if (tch[tp] == 0) {
                                            if (na < fnp[fi]) {
                                                want = fpc[fi * 8 + na];
                                                wantp = pend;
                                            }
                                        }
                                    }
                                    r = parse(1);
                                    pend = pend - 1;
                                    want = sw;
                                    wantp = swp;
                                    r = fix_arg(r, sc, na, fi);
                                    argstk[asp] = r;
                                    asp = asp + 1;
                                    na = na + 1;
                                    if (isop(44)) { adv(); } else { more = 0; }
                                }
                            }
                            eatop(41);
                            if (na != fnp[fi]) { fail(); }
                            l = call_finish(fi, d0, base, na, sc, disc);
                        }
                    }
                } else {
                    if (isop(91)) {
                        adv();
                        fi = lookup_array(v);
                        base = tsib[fi];
                        pend = pend + 1;
                        r = parse(1);
                        pend = pend - 1;
                        eatop(93);
                        l = gen_aread(r, base, tchild[fi], d0);
                    } else {
                        l = lookup_scalar(v);
                    }
                }
            }
        }
    }
    pr = prec();
    while (pr >= p) {
        op = cv;
        adv();
        depth = d0 + 1;
        tmp(d0);
        l = snapshot_global(l, d0);
        pend = pend + 1;
        r = parse(pr + 1);
        pend = pend - 1;
        res = tmp(d0);
        if (pr == 3) { res = result_cell(d0, l, r, 42); gen_mul(res, l, r); }
        if (pr == 2) { res = result_cell(d0, l, r, op); add_sub(res, l, r, op); }
        if (pr == 1) { cmp_value(op, l, r, res); }
        depth = d0 + 1;
        l = res;
        pr = prec();
    }
    return l;
}

func cmp_tail(l, d0) {
    var op; var r; var res;
    while (prec() == 1) {
        op = cv;
        adv();
        depth = d0 + 1;
        tmp(d0);
        l = snapshot_global(l, d0);
        r = parse(2);
        res = tmp(d0);
        cmp_value(op, l, r, res);
        depth = d0 + 1;
        l = res;
    }
    return l;
}

// parse an expression; jump to lf if it is false (zero), fall through otherwise
func cond(lf) {
    var d0; var l; var op; var r; var res;
    d0 = depth;
    l = parse(2);
    if (prec() != 1) {
        jz(l, lf);
        depth = d0;
        return 0;
    }
    op = cv;
    adv();
    depth = d0 + 1;
    tmp(d0);
    l = snapshot_global(l, d0);
    r = parse(2);
    if (prec() == 1) {
        res = tmp(d0);
        cmp_value(op, l, r, res);
        depth = d0 + 1;
        l = cmp_tail(res, d0);
        jz(l, lf);
    } else {
        cmp_jf(op, l, r, lf);
    }
    depth = d0;
    return 0;
}

// ------------------------------------------------------------------ statements
func declare_local(n) {
    var c; var x;
    x = gb[n];
    if (x >= 33554432) { fail(); }
    if (x >= 4194304) { if (x < 8388608) { fail(); } }
    c = newcell();
    locnode[nloc] = n;
    locsave[nloc] = x;
    nloc = nloc + 1;
    gb[n] = 33554432 + c;
    return c;
}

func assign_stmt(v) {
    var x; var e;
    x = lookup_scalar(v);
    want = x;
    wantp = 0;
    e = parse(1);
    want = 0;
    eatop(59);
    setto(x, e);
    return 0;
}

// is the value of an array assignment a literal or a variable?  (parsing it emits no code)
func simple_val() {
    var x;
    x = tv[tp];
    if (x < 0) { return tv[tp + 1] == 262203; }
    if (x >= 131072) {
        if (x < 196608) { return tv[tp + 1] == 262203; }
    }
    if (x == 262189) {
        if (tv[tp + 1] < 0) { return tv[tp + 2] == 262203; }
    }
    return 0;
}

func aassign_stmt(v) {
    var base; var size; var i; var d0; var pt; var val; var p0; var ci; var inb; var src;
    ci = lookup_array(v);
    base = tsib[ci];
    size = tchild[ci];
    i = parse(1);
    eatop(93);
    eatop(61);
    inb = 0;
    if (isconst(i)) {
        ci = constval(i);
        if (ci >= 0) {
            if (ci < size) { inb = 1; }
        }
    }
    if (inb) {
        val = parse(1);
        eatop(59);
        emit2(base + ci, base + ci);
        emit2(base + ci, val);
        return 0;
    }
    if (simple_val()) {
        val = parse(1);
        eatop(59);
        emit2(T, T);
        emit2(T, i);
        emit2(T, lit(base));
        src = T;
    } else {
        d0 = depth;
        depth = d0 + 1;
        pt = tmp(d0);
        if (i == pt) {
            emit2(pt, lit(0 - base));
            val = parse(1);
            eatop(59);
            emit2(T, T);
            emit2(T, pt);
            src = T;
        } else {
            emit2(pt, pt);
            emit2(pt, i);
            emit2(pt, lit(base));
            val = parse(1);
            eatop(59);
            src = pt;
        }
    }
    p0 = pc();
    emit2(p0 + 18, p0 + 18);
    emit2(p0 + 18, src);
    emit2(p0 + 19, p0 + 19);
    emit2(p0 + 19, src);
    emit2(p0 + 21, p0 + 21);
    emit2(p0 + 21, src);
    emit2(0, 0);
    emit2(0, val);
    return 0;
}

// mode 1: parse a block "{ stmts }"; mode 0: parse one statement
func stmt(mode) {
    var v; var e; var lelse; var lend; var ltop; var nx; var lsv;
    if (mode == 1) {
        eatop(123);
        while (isop(125) == 0) {
            if (ck == 0) { fail(); }
            stmt(0);
        }
        eatop(125);
        return 0;
    }
    depth = 0;
    stmt0 = tp;
    pend = 0;
    want = 0;
    stmtcall = 0;
    v = cv;
    if (ck == 3) {
        if (v == 1) {
            adv();
            declare_local(eatname());
            eatop(59);
            return 0;
        }
        if (v == 4) {
            adv();
            eatop(40);
            lelse = newlabel();
            cond(lelse);
            eatop(41);
            stmt(1);
            if (iskw(5)) {
                adv();
                if (iskw(4)) { fail(); }
                lend = newlabel();
                jmp(lend);
                place(lelse);
                stmt(1);
                place(lend);
            } else {
                place(lelse);
            }
            return 0;
        }
        if (v == 6) {
            lsv = loop0;
            if (loop0 < 0) { loop0 = tp; }
            adv();
            eatop(40);
            ltop = newlabel();
            lend = newlabel();
            place(ltop);
            cond(lend);
            eatop(41);
            stmt(1);
            jmp(ltop);
            place(lend);
            loop0 = lsv;
            return 0;
        }
        if (v == 7) {
            adv();
            if (isop(59)) { fail(); }
            want = RV;
            wantp = 0;
            e = parse(1);
            want = 0;
            eatop(59);
            setto(RV, e);
            jmp(f_ra - 2);
            return 0;
        }
        fail();
        return 0;
    }
    if (ck != 2) { fail(); }
    nx = tv[tp + 1];
    if (nx == 262205) {
        adv();
        adv();
        assign_stmt(v);
        return 0;
    }
    if (nx == 262235) {
        adv();
        adv();
        aassign_stmt(v);
        return 0;
    }
    if (nx == 262184) {
        stmtcall = 1;
        parse(4);
        eatop(59);
        return 0;
    }
    fail();
    return 0;
}

// ------------------------------------------------------------------ declarations
func compile_func() {
    var name; var fi; var np; var j; var more; var k; var x;
    adv();
    name = eatname();
    nfuncs = nfuncs + 1;
    if (nfuncs > 200) { fail(); }
    if (gb[name] != 0) { fail(); }
    eatop(40);
    np = 0;
    if (isop(41) == 0) {
        more = 1;
        while (more) {
            pnn[np] = eatname();
            np = np + 1;
            if (np > 8) { fail(); }
            if (isop(44)) { adv(); } else { more = 0; }
        }
    }
    eatop(41);
    fi = nfuncs - 1;
    curfn = fi;
    nt = 0;
    nloc = 0;
    j = tp;
    k = 0;
    more = 1;
    while (more) {
        x = tv[j];
        if (x == 0) {
            more = 0;
        } else {
            if (x == 262267) { k = k + 1; }
            if (x == 262269) {
                k = k - 1;
                if (k == 0) { more = 0; }
            }
            if (more) { j = j + 1; }
        }
    }
    fend = j;
    fbase = dp;
    depth = 0;
    f_ra = pc() + 2;
    emit3(NEG1, ZERO, 0);
    fent[fi] = pc();
    fnp[fi] = np;
    fra[fi] = f_ra;
    gb[name] = 4194304 + fi;
    j = 0;
    while (j < np) {
        fpc[fi * 8 + j] = declare_local(pnn[j]);
        j = j + 1;
    }
    stmt(1);
    clr(RV);
    jmp(f_ra - 2);
    k = nloc;
    while (k > 0) {
        k = k - 1;
        gb[locnode[k]] = locsave[k];
    }
    nloc = 0;
    return 0;
}

func global_decl() {
    var name; var size; var base; var c;
    if (iskw(1)) {
        adv();
        name = eatname();
        eatop(59);
        if (gb[name] != 0) { fail(); }
        c = newcell();
        gb[name] = c;
        gvc[ng] = c;
        ng = ng + 1;
        return 0;
    }
    if (iskw(2)) {
        adv();
        name = eatname();
        eatop(91);
        if (ck != 1) { fail(); }
        size = cv;
        if (size <= 0) { fail(); }
        adv();
        eatop(93);
        eatop(59);
        if (gb[name] != 0) { fail(); }
        base = dp - size + 1;
        if (base < 524288) { fail(); }
        dp = base - 1;
        tsib[narr] = base;
        tchild[narr] = size;
        gb[name] = 2097152 + narr;
        narr = narr + 1;
        return 0;
    }
    if (iskw(3)) {
        compile_func();
        return 0;
    }
    fail();
    return 0;
}

// ------------------------------------------------------------------ driver
func compile_pass() {
    var n; var x; var fm; var rac;
    // reset everything the first pass left behind
    n = 0;
    while (n < nnodes) {
        x = gb[n];
        if (x > 0) { if (x < 8388608) { gb[n] = 0; } }
        n = n + 1;
    }
    tp = 0;
    setcur();
    pcc = 0;
    dp = 1048573;
    npool = 0;
    nlab = 0;
    mul_used = 0;
    nfuncs = 0;
    curfn = 0 - 1;
    depth = 0;
    nt = 0;
    nloc = 0;
    ng = 0;
    asp = 0;
    loop0 = 0 - 1;
    MRA = 8;
    narr = 0;
    pend = 0;
    want = 0;
    wantp = 0;
    stmtcall = 0;
    T = newcell();
    U = newcell();
    T1 = newcell();
    RV = newcell();
    poolv[0] = 0;
    npool = 1;
    LBOOT = newlabel();
    emit3(NEG1, ZERO, 0);
    while (ck != 0) { global_decl(); }
    x = gb[mainnode] - 4194304;
    if (x < 0) { fail(); }
    if (x >= 200) { fail(); }
    fm = x;
    if (fnp[fm] != 0) { fail(); }
    if (mul_used) { emit_mul_routine(); }
    place(LBOOT);
    set_ra(fra[fm], pc() + 9);
    jmp(fent[fm]);
    emit3(NEG1, ZERO, 0 - 1);
    poolv[0] = dp;
    return 0;
}

